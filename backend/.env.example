MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=queuesense
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_at_least_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Provider Configuration (Gmail SMTP, SendGrid, Amazon SES, etc.)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=QueueSense
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5

# Google OAuth 2.0 (Web Client ID ending in .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PORT=8000
HOST=0.0.0.0
